# ---- versions of the official EU reference implementations ----
KEYCLOAK_ABCA_EXTENSION_VERSION=0.2.0
STATUS_LIST_VERSION=v0.9.0
PID_ISSUER_IMAGE=ghcr.io/eu-digital-identity-wallet/eudi-srv-pid-issuer:edge
VERIFIER_IMAGE=ghcr.io/eu-digital-identity-wallet/eudi-srv-verifier-endpoint:latest
VERIFIER_UI_IMAGE=ghcr.io/eu-digital-identity-wallet/eudi-web-verifier:latest

# ---- single public origin, terminated by the gateway (haproxy) ----
PUBLIC_ORIGIN=https://localhost

# ---- host-side services (not containers) ----
CONSOLE_PORT=4000
WALLET_CORE_PORT=4100

# ---- JVM heap caps: keeps the whole stack inside ~3GB ----
KEYCLOAK_HEAP=-Xmx512m
ISSUER_HEAP=-Xmx448m -XX:MaxDirectMemorySize=64M
VERIFIER_HEAP=-Xmx448m
