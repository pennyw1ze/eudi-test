<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.eudi.akprobe"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35" />

    <!-- debuggable so that `adb shell run-as` can read the result file -->
    <application android:label="AK probe" android:debuggable="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <!-- Probe modes in a fresh process, started with am instrument so that late.sh can
         disable hidden-API checks and LateAttestProbe can reach keystore2's binder interface. -->
    <instrumentation android:name="dev.eudi.akprobe.ProbeInstrumentation"
        android:targetPackage="dev.eudi.akprobe" />
</manifest>
